# ---------------------------------------------------------------------------
# BigBag Local Orchestrator (Self-hosted Multi-Model Engine)
# ---------------------------------------------------------------------------
ORCHESTRATOR_MODE=local
SANDBOX_PROVIDER=local

# Model priority: Gemini 2.5 Flash → GLM 4.7 Flash → GLM 4.5 Flash.
# Set at least one key; configure all three for automatic failover.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_MAX_TOKENS=16384
GLM_API_KEY_2=
GLM_MODEL_2=glm-4.7-flash
GLM_API_KEY=
GLM_MODEL=glm-4.5-flash
GLM_MAX_TOKENS=16384
E2B_API_KEY=

# Optional cloud backend fallback:
# TOTALUM_VCAAS_API_KEY=local-orchestrator-active

# ---------------------------------------------------------------------------
# Turso Cloud Database (required when Firebase login is enabled)
# ---------------------------------------------------------------------------
# TURSO_DATABASE_URL=libsql://...
# TURSO_AUTH_TOKEN=
# TURSO_API_TOKEN=
# TURSO_ORG=

# ---------------------------------------------------------------------------
# Account login + project isolation
# ---------------------------------------------------------------------------
# Enable Google in Firebase Authentication and add the deployed hostname to
# Firebase's authorized domains.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Optional Firebase Admin service account values for hosts without application
# default credentials.
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Public base URL of this app. Used by src/proxy.ts to allow-list the origin
# for CSP/CORS in production. Defaults to same-host if unset, so you usually
# only need this for a custom production domain.
# NEXT_PUBLIC_APP_URL=https://your-domain.com
